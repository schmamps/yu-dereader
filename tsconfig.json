{
	"compilerOptions": {
		"lib": ["dom", "ES2017", "ES2019.Array"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"removeComments": true,
		"esModuleInterop": true,
		"rootDir": "src/ts",
		"outDir": "build",
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"files"          : ["src/ts/index.ts"],
	"include"        : ["src/ts/**/*"]
}
