{
	"manifest_version": 3,
	"name": "Yu Dereader - Dinosaur Comics Fun Times!",
	"short_name": "Yu Dereader",
	"version": "3.0.0",
	"description": "Yu Dereader reveals Dinosaur Comics easter eggs for you, the reader",
	"permissions": [],
	"content_scripts": [
		{
			"all_frames": false,
			"js": [
				"yu.js"
			],
			"css": [
				"dereader.css"
			],
			"matches": [
				"*://*.qwantz.com/*"
			]
		}
	],
	"icons": {
		"128": "eye-con.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "yu-dereader@champs.name",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	}
}