{
	"name": "yu-dereader",
	"version": "3.0.0",
	"description": "Yu Dereader - Dinosaur Comics Fun Times!",
	"main": ".",
	"directories": {},
	"scripts": {
		"watch": "gulp js css watch",
		"build": "export NODE_ENV=prod && gulp build && unset NODE_ENV",
		"clean": "rm -f build/**/*.css build/**/*.js build/**/*.json build/**/*.xpi build/**/*.map",
