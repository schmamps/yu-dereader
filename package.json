		"@types/node": "^25.8.0",
		"browserify": "^17.0.1",
		"eslint": "^9.3.0",
		"fancy-log": "^1.3.3",
		"gulp": "^5.0.0",
		"gulp-sass": "^6.0.1",
		"rollup": "^4.60.4",
		"sass": "^1.99.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"web-ext": "^10.3.0"
	},
	"repository": {
