{
	"manifest_version": 3,
	"name": "AUTOGENERATED",
	"short_name": "Yu Dereader",
	"version": "AUTOGENERATED",
	"description": "Yu Dereader reveals Dinosaur Comics easter eggs for you, the reader",
	"permissions": [
		"storage"
	],
	"content_scripts": [
		{
			"all_frames": false,
			"js": [
				"yu.js"
			],
			"css": [
				"dereader.css"
			],
			"matches": [
				"*://*.qwantz.com/*"
			]
		}
	],
	"icons": {
		"128": "eye-con.png"
	},
	"web_accessible_resources": [
		{
			"resources": [
				"eye-con.png",
				"eye-smooth.png"
			],
			"matches": [
				"<all_urls>"
			]
		}
	],
	"browser_specific_settings": {
		"gecko": {
			"id": "yu-dereader@champs.name",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	}
}
